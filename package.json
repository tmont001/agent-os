{
  "name": "agent-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent": "tsx src/cli/index.ts",
    "smoke:anthropic": "node --env-file-if-exists=.env --import=tsx src/cli/index.ts --provider anthropic",
    "start": "node --env-file-if-exists=.env --import=tsx src/http/server.ts",
    "dev": "node --env-file-if-exists=.env --watch --import=tsx src/http/server.ts",
    "dev:web": "npm run dev --workspace apps/web",
    "typecheck:web": "npm run typecheck --workspace apps/web",
    "test:web": "npm run test --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "typecheck:all": "npm run typecheck && npm run typecheck:web",
    "test:all": "npm test && npm run test:web"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
