# Required only by the HTTP server (npm run start / npm run dev) — there is
# no default. The CLI (npm run agent) selects its provider via its own
# --provider flag instead and does not read this variable.
# fake:      offline, deterministic, no network access
# anthropic: real Anthropic API; requires ANTHROPIC_API_KEY below
AI_PROVIDER=fake

# Required only when AI_PROVIDER=anthropic (HTTP server), or when the CLI is
# run with --provider anthropic.
ANTHROPIC_API_KEY=

# Optional. HTTP server port (1-65535). Defaults to 3000 if unset.
PORT=3000
